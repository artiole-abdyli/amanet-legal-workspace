# Copy this file to .env and fill in the secrets.
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Postgres, as started by docker-compose.yml
DATABASE_URL="postgresql://amanet:amanet@localhost:5432/amanet?schema=public"

# Base URL used to build the secure links that are emailed to clients
APP_URL="http://localhost:3000"

# Signs the Admin session cookie
AUTH_SECRET=""

# Mixed into secure-link tokens before hashing, so database access alone
# is not enough to forge a working upload or signing link
SECURE_LINK_PEPPER=""

# Where uploaded and signed PDFs are stored by the local storage adapter
STORAGE_DIR="./.storage"

# Email. "outbox" records messages in the database and shows them in the app.
# Set to "resend" with an API key to send for real.
EMAIL_TRANSPORT="outbox"
EMAIL_FROM="Harlow & Vance LLP <no-reply@harlowvance.example>"
RESEND_API_KEY=""
